# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/pdf-form-saas

# JWT Secret (Change this to a strong random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# Client Configuration
REACT_APP_API_URL=http://localhost:5000

# OpenAI (optional) — refines auto-detected field labels/types on upload.
# Without it, uploads still work using structural detection alone.
# Set the real value in your host's environment settings, never in a file.
OPENAI_API_KEY=
